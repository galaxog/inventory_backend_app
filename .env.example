# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- DB ---
# Dev uses Postgres by default
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:postgres@localhost:5432/app

# Tests can use sqlite out-of-the-box; replace with Postgres if you prefer.
SQLALCHEMY_DATABASE_URI_TEST=sqlite+pysqlite:///./test.db

# --- JWT ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_HOURS=4
JWT_REFRESH_TOKEN_EXPIRES_HOURS=48

# --- Security ---
BCRYPT_LOG_ROUNDS=12
MIN_PASSWORD_LEN=8
